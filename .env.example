# LLM Provider — choose one: bedrock | anthropic | ollama
LLM_PROVIDER=bedrock

# Amazon Bedrock
# MODEL_ID=...             # Bedrock model or inference-profile ID for generation
#                         # (default: us.anthropic.claude-haiku-4-5-20251001-v1:0)
# EMBEDDING_PROVIDER=bedrock          # enables semantic search
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Anthropic direct (alternative to Bedrock)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local, no account required) — set LLM_PROVIDER=ollama above
# OLLAMA_BASE_URL=http://localhost:11434/api   # must include /api (default: http://127.0.0.1:11434/api)
# OLLAMA_MODEL=llama3.1                         # must support tool calling (default: llama3.1)
# OLLAMA_NUM_CTX=16384                          # context window sent as num_ctx on every request;
#                                               # keep >= CONTEXT_BUDGET_TOKENS + 4096 (default: 16384)
# EMBEDDING_PROVIDER=ollama                     # enables semantic search with a local model
# EMBEDDING_MODEL_ID=nomic-embed-text           # nomic-embed-text | mxbai-embed-large | all-minilm
# EMBEDDING_DIMENSIONS=768                      # only for embedding models outside that list

# Vault
VAULT_ROOT=/path/to/your/obsidian/vault

# Context budget (max tokens allocated to vault context per request)
CONTEXT_BUDGET_TOKENS=8000

# Logging
# LOG_LEVEL=info          # trace | debug | info | warn | error | silent (default: info)
# LOG_FILE=lorecraft.log  # path to JSON log file (default: lorecraft.log in cwd)
